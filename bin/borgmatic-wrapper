#!/bin/bash

# Allow definition of Borgmatic extensions by putting an executable "borgmatic-foo"
# somewhere in the PATH.

typeset borgmaticExtension="borgmatic-$1"
if [ $# -eq 0 ]; then
    exec "${BASH_SOURCE[0]}" create
elif type -t "$borgmaticExtension" >/dev/null; then
    shift; eval $borgmaticExtension '"$@"'
else
    command borgmatic "$@"
fi
